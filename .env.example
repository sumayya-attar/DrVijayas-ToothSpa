# GEMINI_API_KEY: Optional Gemini API key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL where this app is hosted (for canonical links & sitemap).
APP_URL="MY_APP_URL"

# Google Maps Platform API key (for interactive map & Places API lookup)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Supabase Backend Configuration
SUPABASE_PROJECT_ID="MY_SUPABASE_PROJECT_ID"
SUPABASE_URL="https://MY_SUPABASE_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"
# Optional: Add SUPABASE_SECRET_KEY (service_role / sb_secret_...) for server-side status updates & reads
SUPABASE_SECRET_KEY=""

# Admin authentication & session configuration
ADMIN_INITIAL_EMAIL="admin@drvijayastoothspa.com"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
SESSION_SECRET="CHANGE_ME_RANDOM_64_CHAR_HEX"

# Optional SMTP configuration for automated appointment confirmation emails
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DrVijayas ToothSpa <appointments@drvijayastoothspa.com>"

# Optional WhatsApp Business Cloud API configuration for automated notifications
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="appointment_confirmation"
